# ---------------------------------------------------------------------------
# Optional AI review. Without a key the enhanced offline engine still runs:
# phrase rules, URL/brand forensics and scam-scenario detection (OTP theft,
# money transfer, investment fraud, job scams, romance scams and more).
#
# Pick ANY ONE provider below. The first configured key is used automatically.
# Restart the dev server after changing this file.
# ---------------------------------------------------------------------------

# OpenAI (best quality)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Groq (fast + generous free tier)
# GROQ_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# OpenRouter (many models behind one key)
# OPENROUTER_API_KEY=

# DeepSeek
# DEEPSEEK_API_KEY=

# Mistral
# MISTRAL_API_KEY=

# Together AI
# TOGETHER_API_KEY=

# Local Ollama (free, private, no key). Set the base URL to enable it.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# Any other OpenAI-compatible endpoint
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=model-name

# Force a specific provider id: openai | groq | gemini | openrouter |
# deepseek | mistral | together | ollama | custom
# AI_PROVIDER=openai
